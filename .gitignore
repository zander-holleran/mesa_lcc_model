# Ignore Python bytecode files
__pycache__/
*.py[cod]

# Ignore Jupyter Notebook checkpoints
.ipynb_checkpoints/

# Ignore environment files
.env
venv/

# ignore data contents (keep directory structure)
data/*
!data/.gitkeep

# ignore test baselines (generated locally, keep directory structure)
tests/baselines/*
!tests/baselines/.gitkeep

notes/
plans/
.DS_Store
prof.stats
